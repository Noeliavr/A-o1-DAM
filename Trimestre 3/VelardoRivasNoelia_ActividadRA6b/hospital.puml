@startuml
title Diagrama de casos de un hospital
skinparam monochrome true
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Personal médico" as PersonalBase
actor "Enfermero" as Enf
actor "Médico" as Med
actor "Farmacia estatal" as Farmacia

' Herencia de actores
PersonalBase <|-- Enf
PersonalBase <|-- Med

rectangle "ERP hospitalario" {
    usecase "Consultar historial" as UC1
    usecase "Registrar constantes" as UC2
    usecase "Recetar medicamento" as UC3
    usecase "Diagnosticar" as UC4
    usecase "Emitir alerta de alergia" as UC5
}

' Relaciones actor-caso de uso
PersonalBase -- UC1
Enf -- UC2
Med -- UC3
Med -- UC4
Farmacia -- UC3

' Relación opcional por condición
UC5 ..> UC3 : <<extend>>
@enduml
